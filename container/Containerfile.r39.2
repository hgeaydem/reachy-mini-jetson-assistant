#
# Reachy Mini Jetson Assistant — JetPack 7.2 / L4T r39.2 (AGX Thor / Orin devkit,
# Ubuntu 24.04 noble, Python 3.12, aarch64). Built on an aarch64 podman host
# (container/build_thor.sh; see container/README.md).
#
# Base (validated on Thor, 2026-10-13):
#   NVIDIA publishes NO L4T container image for r39.2, so we start from
#   docker.io/whitesscott/l4t-jetpack:r39.2.1 (community, r39.2.1-matched).
#   It already carries the JetPack-optimized GStreamer 1.24.2 (nv* plugins) plus
#   the full apt dev set, so we build ON TOP of the system GStreamer — no
#   source-built GStreamer, no side prefix.
#
# Wireless media (rswebrtc):
#   The assistant's app/remote_media.py and the SDK's webrtc_client_gstreamer.py
#   need the rswebrtc elements `webrtcsrc` (camera-in) and `webrtcsink` (audio-out).
#   No apt package ships them for aarch64, so we build ONLY the Rust plugin
#   (gst-plugins-rs net/webrtc, cdylib `gstrswebrtc`) against the system GStreamer:
#     * gst-plugins-rs @ gstreamer-1.24.0 (workspace gstreamer-rs branch 0.22),
#       --no-default-features -> FFI floor GStreamer 1.20, so one recipe also
#       builds on the r36.4 base (GStreamer 1.20.3).
#     * its Cargo.lock pins `time 0.3.34` (2024), which does not compile on
#       rustc >= 1.80; the script bumps it to 0.3.47 before building.
#   Thor-validated 2026-10-13: `RSWERTC_OK gst=1.24.2`, webrtcsrc + webrtcsink
#   PRESENT via gst-inspect (see container/README.md). Default BUILD_WEBRTC=1.
#
# GPU runtimes:
#   CTranslate2 (STT) + ONNX Runtime (TTS) are the exact wheels published for
#   platform `jp72-l4t39.2-cu13.2-py3.12-sm87` in packaging/jetson-wheels.json
#   (release `native-jp72-cu132-py312-sm87-r1`, published). The layer below
#   downloads them from that manifest, verifies SHA-256 + size, and installs —
#   so the image never drifts from the manifest.

ARG BASE_IMAGE=docker.io/whitesscott/l4t-jetpack:r39.2.1
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
ARG PYTHON_VERSION=3.12
ARG BUILD_WEBRTC=1

# ------------------------------------------------------------------------------
# 0. r39.2 apt repo (NVIDIA GPG key; trusted=yes for container build).
# ------------------------------------------------------------------------------
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl; \
    curl -fsSL https://repo.download.nvidia.com/jetson/jetson-ota-public.asc \
        -o /etc/apt/trusted.gpg.d/nvidia-jetson.asc || \
    echo 'deb [trusted=yes] https://repo.download.nvidia.com/jetson/common r39.2 main' \
        > /etc/apt/sources.list.d/nvidia-r392.list; \
    apt-get update

# ------------------------------------------------------------------------------
# 1. Confirm JetPack-optimized GStreamer is already present; fill gaps only.
#    The base's 1.24.2 GStreamer is used as-is (incl. libgstwebrtc-1.0.so).
# ------------------------------------------------------------------------------
RUN set -eux; \
    echo '--- gstreamer pkgs in base ---'; \
    dpkg -l 2>/dev/null | awk '/^ii/ {print $2, $3}' | grep -iE 'gstreamer|nvidia-l4t'; \
    nvcount=$(ls /usr/lib/aarch64-linux-gnu/gstreamer-1.0/ 2>/dev/null | grep -cE '^libgstnv'); \
    echo "nv* gstreamer plugins: ${nvcount}"; \
    if [ "${nvcount}" -lt 5 ]; then \
        echo 'optimized gstreamer missing — installing from r39.2 repo'; \
        apt-get update; \
        apt-get install -y --no-install-recommends \
            nvidia-l4t-gstreamer nvidia-l4t-multimedia 2>/dev/null || \
        apt-get install -y --no-install-recommends nvidia-l4t-multimedia-utils || true; \
    fi; \
    ldconfig

# ------------------------------------------------------------------------------
# 2. Python + GStreamer runtime + PortAudio (sounddevice links it on Linux) +
#    the dev headers needed to build PyGObject from source (sdist-only).
#    The Rust toolchain and gst dev headers required by the rswebrtc plugin are
#    installed by container/gst_rswebrtc_sys.sh itself, keeping that recipe
#    self-contained and identical to the Thor-validated one.
# ------------------------------------------------------------------------------
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        python${PYTHON_VERSION} python${PYTHON_VERSION}-venv python${PYTHON_VERSION}-dev \
        python3-pip python3-wheel \
        gstreamer1.0-tools gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
        gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly gstreamer1.0-libav \
        gstreamer1.0-alsa \
        libgstreamer1.0-0 libglib2.0-0 \
        libportaudio2 libportaudio-dev \
        libglib2.0-dev libgirepository1.0-dev gobject-introspection pkg-config \
        build-essential ca-certificates curl \
    ; \
    ldconfig

# ------------------------------------------------------------------------------
# 3. venv. (GPU wheels are installed in step 4 from the project manifest.)
# ------------------------------------------------------------------------------
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
RUN set -eux; python${PYTHON_VERSION} -m venv /opt/venv; \
    . /opt/venv/bin/activate; \
    pip install --no-cache-dir --upgrade pip wheel

# ------------------------------------------------------------------------------
# 4. App + SDK + GPU runtimes.
#    * PyGObject 3.46.0 is built from the sdist (no aarch64 wheel exists) to
#      satisfy reachy-mini's Linux pin (>=3.42.2, <=3.46.0).
#    * reachy-mini==1.3.1[gstreamer] — the version the project docs pin.
#    * GPU wheels: the exact set from packaging/jetson-wheels.json (published
#      release), downloaded + SHA-256/size-verified, then installed.
# ------------------------------------------------------------------------------
COPY . /build
RUN set -eux; \
    . /opt/venv/bin/activate; \
    pip install --no-cache-dir 'PyGObject==3.46.0'; \
    python - <<'PY'; \
import json, hashlib, urllib.request
m = json.load(open("/build/packaging/jetson-wheels.json"))
plat = m["platforms"]["jp72-l4t39.2-cu13.2-py3.12-sm87"]
assert plat["release"]["published"], "JP7.2 wheel release not marked published"
base = plat["release"]["base_url"]
for name in ("ctranslate2", "onnxruntime_gpu"):
    w = plat["wheels"][name]
    url = base + "/" + w["filename"]
    data = urllib.request.urlopen(url, timeout=600).read()
    assert hashlib.sha256(data).hexdigest() == w["sha256"], name + " sha256 mismatch"
    assert len(data) == w["size"], name + " size mismatch"
    open("/tmp/" + w["filename"], "wb").write(data)
    print("verified", w["filename"])
PY; \
    pip install --no-cache-dir /tmp/ctranslate2-*.whl /tmp/onnxruntime_gpu-*.whl; \
    pip install --no-cache-dir 'reachy-mini==1.3.1[gstreamer]'; \
    pip install --no-cache-dir -r /build/requirements.txt; \
    echo '--- runtime checks ---'; \
    python -c "import reachy_mini; print('reachy-mini', reachy_mini.__version__)"; \
    python -c "import ctranslate2 as c; print('ctranslate2', c.__version__, 'cuda', c.get_cuda_device_count())"; \
    python -c "import onnxruntime as o; print('onnxruntime', o.__version__, o.get_available_providers())"; \
    python -c "import gi; gi.require_version('Gst','1.0'); from gi.repository import Gst; Gst.init(None); print('Gst', Gst.version_string())"

# ------------------------------------------------------------------------------
# 5. Build + smoke-test the rswebrtc plugin (gated by BUILD_WEBRTC).
# ------------------------------------------------------------------------------
COPY container/gst_rswebrtc_sys.sh /tmp/gst_rswebrtc_sys.sh
RUN if [ "${BUILD_WEBRTC}" = "1" ]; then \
        set -eux; \
        bash /tmp/gst_rswebrtc_sys.sh; \
        . /opt/venv/bin/activate; \
        python -c "import gi; gi.require_version('Gst','1.0'); \
from gi.repository import Gst; Gst.init(None); \
assert Gst.ElementFactory.make('webrtcsrc') is not None, 'webrtcsrc missing'; \
assert Gst.ElementFactory.make('webrtcsink') is not None, 'webrtcsink missing'; \
print('RSWERTC_OK (PyGObject)')"; \
    else \
        echo 'BUILD_WEBRTC=0 — rswebrtc plugin not installed'; \
    fi

# ------------------------------------------------------------------------------
# 6. App in place. The assistant is NOT pip-installable (no pyproject.toml); it
#    runs in place from /opt/assistant. Models auto-download at first run.
# ------------------------------------------------------------------------------
WORKDIR /opt/assistant
COPY . /opt/assistant
RUN set -eux; \
    if [ -d /opt/venv ]; then ln -sf /opt/venv/bin/python3 /usr/local/bin/python3; fi

ENV ASSISTANT_HOME=/opt/assistant
# Wireless profile (robot daemon + media over WebRTC). For the USB "Lite"
# profile override: REACHY_ASSISTANT_CONFIG=/opt/assistant/config/settings.yaml
ENV REACHY_ASSISTANT_CONFIG=/opt/assistant/config/settings.wireless.yaml
CMD ["python", "run_web_vision_chat.py"]
